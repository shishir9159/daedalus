}

.markdown-preview-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h350-" i], [src*="-h350." i])),
.cm-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h350-" i], [src*="-h350." i])) {
