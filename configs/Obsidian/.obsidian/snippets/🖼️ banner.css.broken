}

.markdown-preview-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h340-" i], [src*="-h340." i])),
.cm-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h340-" i], [src*="-h340." i])) {
