    /* --ab-s: min(360px, var(--ab-height-cap)); */
}

.markdown-preview-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h370-" i], [src*="-h370." i])),
.cm-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h370-" i], [src*="-h370." i])) {
