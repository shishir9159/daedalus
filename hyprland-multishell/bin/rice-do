#!/usr/bin/env bash
# rice-do <profile> -- <command...>  -- run a command in a profile's XDG env.
# Use it for every rice installer:  rice-do caelestia -- caelestia install
set -euo pipefail
# shellcheck source=../lib/rice-common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/rice-common.sh"

PROFILE="${1:-}"; shift || true
[ "${1:-}" != "--" ] || shift
{ [ -n "$PROFILE" ] && [ $# -gt 0 ]; } || { echo "usage: rice-do <profile> -- <command...>" >&2; exit 2; }
PDIR="$(rice_profile_dir "$PROFILE" --must-exist)"

# Refresh links first, so apps added to ~/.config since login stay shared.
"$RICE_ROOT/bin/rice-sync" "$PROFILE" --quiet || echo "rice-do: rice-sync failed, continuing" >&2
rice_export_env "$PROFILE" "$PDIR"
rice_source_env_file "$PDIR"
exec "$@"
