#!/usr/bin/env bash
# rice-session <profile> ["Display Name" | --remove] -- add/remove the greeter entry.
# Writes $RICE_SESSIONS_DIR (sudo): the greeter can't read your home.
set -euo pipefail
# shellcheck source=../lib/rice-common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/rice-common.sh"

SUDO="${RICE_SUDO-sudo}"
PROFILE="${1:-}"
[ -n "$PROFILE" ] || rice_usage 'rice-session <profile> ["Display Name" | --remove]'
rice_valid_name "$PROFILE" || rice_die "invalid profile name '$PROFILE'"
DESKTOP="$RICE_SESSIONS_DIR/rice-$PROFILE.desktop"

if [ "${2:-}" = --remove ]; then
    if [ -e "$DESKTOP" ]; then $SUDO rm -f "$DESKTOP"; echo "removed $DESKTOP"; else echo "not registered"; fi
    exit 0
fi

PDIR="$(rice_profile_dir "$PROFILE" --must-exist)"
NAME="${2:-$(rice_env_get "$PDIR" DISPLAY_NAME)}"
NAME="${NAME:-Hyprland ($PROFILE)}"
case "$NAME" in *$'\n'*) rice_die "display name must be one line" ;; esac

# TryExec: greeters hide the entry if the launcher is gone, instead of bouncing.
$SUDO install -Dm644 /dev/stdin "$DESKTOP" <<DESK
[Desktop Entry]
Name=$NAME
Comment=Hyprland, rice profile '$PROFILE'
TryExec=$RICE_LAUNCHER
Exec=$RICE_LAUNCHER $PROFILE
Type=Application
DesktopNames=Hyprland
DESK
echo "installed $DESKTOP ($NAME)"
