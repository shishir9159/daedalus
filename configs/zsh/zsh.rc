# ~/.zshrc (dotter package `zsh`).

# CachyOS's defaults, which its stock ~/.zshrc sources: oh-my-zsh (compinit,
# history options, aliases), powerlevel10k and its ~/.p10k.zsh (p10k.zsh, next
# to this file), autosuggestions, highlighting.
[[ -r /usr/share/cachyos-zsh-config/cachyos-config.zsh ]] && source /usr/share/cachyos-zsh-config/cachyos-config.zsh
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }

# CachyOS sets ENABLE_CORRECTION="true" stupidly for zsh to second-guesses every argument
# ('config' -> 'configs'). God awful people.
unsetopt correct correct_all

# All of the history. oh-my-zsh saves only 10000 lines, and zsh has no
# unlimited (HISTSIZE above SAVEHIST leaves hist_expire_dups_first room).
# oh-my-zsh's `history` alias lists from the first entry; plain zsh's `history`
# lists the last 16.
HISTFILE=${HISTFILE:-$HOME/.zsh_history} HISTSIZE=1200000 SAVEHIST=1000000
(( $+aliases[history] )) || alias history='fc -l 1'

# Where uv tools and global bun/pnpm packages land; (N/) drops missing dirs.
typeset -U path
export PNPM_HOME="$HOME/.local/share/pnpm"
path=($HOME/.local/bin(N/) $HOME/.bun/bin(N/) $PNPM_HOME(N/) $path)
# >>> daedalus configs/sh/env.sh: edit it there, then dotter deploy >>>
# rice-theme (hyprland-multishell/bin)
export PATH="$HOME/.rices/bin:$PATH"
# <<< daedalus configs/sh/env.sh <<<

export EDITOR=nvim VISUAL=nvim   # configs/nvim
alias vi=nvim vim=nvim

# bun, fnm and pnpm are pacman's (hyprland-multishell/bootstrap-packages.sh):
# paru updates them, and their self-updaters would fight it. CachyOS aliases
# update to `sudo pacman -Syu`; while that exists, `update() {` is a parse
# error that ends this file there, and the alias would beat the function.
(( $+aliases[update] )) && unalias update
update() {
  paru -Syyu
  rustup update
  uv tool upgrade --all
  herdr update
  git -C ${XDG_DATA_HOME:-~/.local/share}/noctalia/plugins/wallpaperCarousel pull --ff-only   # bootstrap.sh's clone
}

# What fills the disks, read-only, the biggest last in each part. / is this
# filesystem alone: CachyOS's btrfs has /home, /var/cache and /var/log as
# subvolumes of their own (each its own device to dust -x), so /var and home
# get their own parts.
disk_inspection() {
  local -a cached zips; local mod
  print -P '%B:: filesystems%b';            duf -only local
  print -P '\n%B:: / (this filesystem)%b';  sudo dust -x -d 2 -n 20 /
  print -P '\n%B:: /var%b';                 sudo dust -d 1 -n 10 /var
  print -P '\n%B:: home%b';                 dust -d 1 -n 15 ~
  print -P '\n%B:: ~/.cache%b';             dust -d 1 -n 15 ~/.cache
  cached=( ~/.cache/{paru,pip,uv} ~/.cargo/{registry,git} ~/.npm ~/.local/share/pnpm/store
           ~/.bun/install/cache ~/.gradle/caches /var/cache/pacman/pkg /var/log/journal /var/lib/systemd/coredump )
  (( $+commands[go] )) && cached+=( ${(f)"$(go env GOCACHE GOMODCACHE)"} )
  print -P '\n%B:: what clean empties%b';   sudo dust -p -d 0 ${(u)^cached}(N/)
  if (( $+commands[go] )) && mod=$(go env GOMODCACHE) && [[ -d $mod ]]; then
    zips=( $mod/cache/download/**/@v/*.zip(N) )
    print -P "\n%B:: go modules: $#zips versions, by extracted size%b"
    dust -d 3 -n 15 -X $mod/cache $mod
  fi
  print -P '\n%B:: biggest packages%b'
  LC_ALL=C pacman -Qi | awk '/^Name/ { n = $3 } /^Installed Size/ { print $4 $5, n }' | sort -h | tail -15
  print -P '\n%B:: packages nothing needs, cycles too (clean removes them)%b'
  pacman -Qqd | pacman -Rsu --print --print-format '%s %n' - 2>/dev/null | numfmt --to=iec | sort -h
}

clean() {
  paru -Sccd   # pacman's whole cache, and paru's AUR clones
  paru -cc     # orphans, AUR make deps too; -Rsn $(paru -Qdtq) failed when there were none
  rm -rf ~/.cache/paru
  sudo journalctl --rotate --vacuum-time=1d --vacuum-size=50M
  sudo systemd-tmpfiles --clean
  uv cache prune
  (( $+commands[pip3] )) && pip3 cache purge
  rm -rf ~/.cargo/registry/cache ~/.cargo/git/db
  (( $+commands[go] )) && go clean -cache -modcache
  bun pm cache rm
  pnpm store prune --force
  npm cache clean --force
}

(( $+commands[fzf] )) && source <(fzf --zsh)
(( $+commands[uv] )) && eval "$(uv generate-shell-completion zsh)"
(( $+commands[uvx] )) && eval "$(uvx --generate-shell-completion zsh)"
(( $+commands[fnm] )) && eval "$(fnm env --use-on-cd --shell zsh)"

(( $+commands[mcfly] )) && eval "$(mcfly init zsh)"
(( $+commands[procs] )) && source <(procs --gen-completion-out zsh)
# pacman's just puts _just where compinit already found it; this is for one
# from cargo or uv.
(( $+commands[just] && ! $+functions[_just] )) && source <(just --completions zsh)
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# Caps <-> Esc. X11 only: under Wayland setxkbmap reaches nothing but XWayland;
# Hyprland has it as kb_options in configs/hypr/config/inputs.lua.
# An `if`, not `&&`: as the last line, a false test would be the status every
# new prompt starts with.
if [[ $XDG_SESSION_TYPE == x11 ]] && (( $+commands[setxkbmap] )); then
  setxkbmap -option caps:swapescape
fi
