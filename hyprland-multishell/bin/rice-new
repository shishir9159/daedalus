#!/usr/bin/env bash
# rice-new <profile> ["Display Name"] -- create an isolated profile. Idempotent.
set -euo pipefail
# shellcheck source=../lib/rice-common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/rice-common.sh"

PROFILE="${1:-}"
[ -n "$PROFILE" ] || { echo "usage: rice-new <profile> [\"Display Name\"]" >&2; exit 2; }
PDIR="$(rice_profile_dir "$PROFILE")"
NAME="${2:-Hyprland ($PROFILE)}"
case "$NAME" in *$'\n'*|*'"'*) rice_die "display name must not contain newlines or quotes" ;; esac

mkdir -p "$PDIR"/{config,data,state,cache} "$PDIR/config/hypr" \
         "$PDIR/config/rice-theme"/{generated,locked,themes,active,templates}
cp -n "$RICE_ROOT"/templates/* "$PDIR/config/rice-theme/templates/" 2>/dev/null || true

write_once() { [ -f "$1" ] || cat > "$1"; }   # <file>, content on stdin

write_once "$PDIR/profile.env" <<ENV
# Sourced by hypr-profile and rice-do for '$PROFILE'.
DISPLAY_NAME="$NAME"
USE_UWSM=0
# USE_UWSM=1 only for rices that ship uwsm units (caelestia).
# HYPRLAND_BIN=/opt/hyprland-0.45/bin/Hyprland   (default: start-hyprland, else Hyprland)
# HYPRLAND_CONFIG=\$XDG_CONFIG_HOME/hypr/hyprland.lua
# PRE_EXEC="..."   runs BEFORE Hyprland: no hyprctl/hyprpm here, use exec-once.
ENV

write_once "$PDIR/owned.txt" <<'OWN'
# This profile's changes to ~/.rices/owned.default.txt: "name" owns, "!name" shares.
OWN

# Snapshot whitelist: config/ plus the state that matters (Noctalia's GUI settings).
write_once "$PDIR/.gitignore" <<'GI'
/*
!/.gitignore
!/profile.env
!/owned.txt
!/repos.txt
!/config/
!/state/
/state/*
!/state/noctalia/
/state/noctalia/*
!/state/noctalia/settings.toml
/config/rice-theme/generated/
/config/rice-theme/active/
/config/rice-theme/.lock
*.log
*.sock
*.pid
*secret*
*.key
*.pem
GI
[ -d "$PDIR/.git" ] || git -C "$PDIR" init -q

"$RICE_ROOT/bin/rice-sync" "$PROFILE" --quiet
echo "profile ready: $PDIR"
echo "next: rice-do $PROFILE -- <installer>   then: rice-session $PROFILE"
