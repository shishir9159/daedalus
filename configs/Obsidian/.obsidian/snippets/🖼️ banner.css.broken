    /* --ab-s: min(350px, var(--ab-height-cap)); */
}

.markdown-preview-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h360-" i], [src*="-h360." i])),
.cm-sizer:has(.internal-embed[src*="banner-" i]:is([src*="-h360-" i], [src*="-h360." i])) {
