# A whitelist: everything is ignored unless a line below lets it in, so a new
# file stays untracked until it gets one.
*
!*/

!/.gitignore
!/.gitattributes
!/.shellcheckrc
!/.github/workflows/*.yml
!/.dotter/global.toml
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/configs/nvim/README.md
!/configs/nvim/pack/plugins/start/surround.nvim/README.md

!/linux/manjaro-bootstrap.sh
!/linux/zsh.rc

!/windows/readme.md
!/windows/profile.ps1
!/windows/*.omp.toml

!/configs/okular/okularrc
!/configs/okular/okularpartrc
!/configs/vesktop/*.css
!/configs/Obsidian/Vault/.obsidian/snippets/*.css
!/configs/Obsidian/Vault/Meta/Obsidian/_datacore/**/*.jsx

!/configs/nvim/init.lua
!/configs/nvim/nvim-pack-lock.json
!/configs/nvim/lsp/*.lua
!/configs/nvim/lua/**/*.lua
!/configs/nvim/pack/plugins/start/surround.nvim/.gitattributes
!/configs/nvim/pack/plugins/start/surround.nvim/pkg.json
!/configs/nvim/pack/plugins/start/surround.nvim/**/*.lua

!/hyprland-multishell/**/README.md
!/hyprland-multishell/*.sh
!/hyprland-multishell/owned.default.txt
!/hyprland-multishell/bin/*
!/hyprland-multishell/lib/*.sh
!/hyprland-multishell/system/*
!/hyprland-multishell/tests/*.sh
!/hyprland-multishell/tools.d/*.sh
!/hyprland-multishell/templates/*.tmpl
!/hyprland-multishell/backup/*.sh
!/hyprland-multishell/backup/systemd/*.service
!/hyprland-multishell/backup/systemd/*.timer
