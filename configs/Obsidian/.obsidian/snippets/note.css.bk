.markdown-preview-view img,
.markdown-source-view img,
.cm-contentContainer img {
    image-rendering: auto;
    /* image-rendering: -webkit-optimize-contrast; smooth is still experimental */
}

body {
    --metadata-display-reading: none;
    --line-height-normal: 1.6;
    /* default 1.5 */
    --p-spacing: 1.2rem;
    /* default 1rem */
    --file-line-width: 46rem;
    /* readable line length need to be enabled*/

    /* --heading-spacing: 2.2rem; */
    /* space above headings */

    /* --code-white-space: pre-wrap; */
    /* wrap long lines instead of scrolling (maybe done by code editor style already) */
    --code-size: 0.9em;
    /* --blockquote-font-style: normal;
    --blockquote-border-thickness: 3px; */

    --table-row-alt-background: var(--background-secondary);
    --table-header-weight: var(--font-semibold);
    /* --link-decoration: none; */
    /* --link-decoration-hover: underline; */
}

/* De-emphasize markdown syntax characters: #, **, [[ ]], etc. */
.markdown-source-view.mod-cm6 .cm-formatting {
    opacity: 0.70;
}

/* Highlight the line the cursor is on */
.markdown-source-view.mod-cm6 .cm-line.cm-active {
    background: var(--background-modifier-hover);
}

.markdown-rendered pre {
    border-left: solid;
}

.markdown-source-view.mod-cm6 .cm-line.HyperMD-codeblock {
    border-left: solid;
}

/* might be useful for zen mode
:is(.cm-line, p, h1, h2, h3, h4, h5, h6)::first-letter {
    margin: 0.36rem;
    color: var(--text-normal);
    font-size: 2em;
    font-weight: bold;
    color: var(--text-accent);
}

=========================================================
   cssclass: bg-img - background image for a single note

   Add to the note's frontmatter:
     ---
     cssclasses:
       - bg-img
     ---

   Set --bg-img-url below. Relative paths resolve from
   .obsidian/snippets/, e.g. url("../../Attachments/paper.jpg")
   A web URL or base64 data URL works too.

   --bg-img-veil is a solid layer painted over the image;
   raise its alpha if text is hard to read, lower it to let
   more of the image through.

.markdown-source-view.bg-img,
.markdown-preview-view.bg-img {
    --bg-img-url: url("../../Attachments/background.jpg");
    --bg-img-veil: rgba(255, 255, 255, 0.82);

    background-image:
        linear-gradient(var(--bg-img-veil), var(--bg-img-veil)),
        var(--bg-img-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.theme-dark .markdown-source-view.bg-img,
.theme-dark .markdown-preview-view.bg-img {
    --bg-img-veil: rgba(0, 0, 0, 0.72);
}  */

/* Let the image show through the editor surface */
